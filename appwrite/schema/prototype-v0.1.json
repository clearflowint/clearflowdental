{
  "schemaVersion": "0.2",
  "databaseId": "clearflow_dental",
  "tableDefaults": {
    "rowSecurity": true,
    "tablePermissions": []
  },
  "tables": {
    "clinics": {
      "columns": [
        "name",
        "slug",
        "timezone",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ],
      "indexes": [
        "slug_unique"
      ]
    },
    "clinic_memberships": {
      "columns": [
        "tenantId",
        "userId",
        "role",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "indexes": [
        "tenant_user_unique",
        "user_status"
      ]
    },
    "patients": {
      "columns": [
        "tenantId",
        "patientNumber",
        "givenName",
        "familyName",
        "dateOfBirth",
        "sexOrGender",
        "notesForReception",
        "status",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ],
      "indexes": []
    },
    "patient_contacts": {
      "columns": [
        "tenantId",
        "patientId",
        "type",
        "value",
        "label",
        "isPrimary",
        "isVerified",
        "createdAt",
        "updatedAt"
      ],
      "indexes": [
        "tenant_patient"
      ]
    },
    "patient_documents": {
      "columns": [
        "tenantId",
        "patientId",
        "encounterId",
        "storageFileId",
        "originalName",
        "mimeType",
        "sizeBytes",
        "sourceCategory",
        "sourceDate",
        "uploadedBy",
        "uploadedAt",
        "reviewStatus",
        "sourceProviderName"
      ],
      "indexes": [
        "tenant_patient_uploaded"
      ]
    },
    "appointments": {
      "columns": [
        "tenantId",
        "patientId",
        "providerUserId",
        "startsAt",
        "endsAt",
        "status",
        "reason",
        "notes",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ],
      "indexes": [
        "tenant_starts"
      ]
    },
    "encounters": {
      "columns": [
        "tenantId",
        "patientId",
        "appointmentId",
        "startedAt",
        "endedAt",
        "status",
        "visitPurpose",
        "summary",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ],
      "indexes": [
        "tenant_patient_started"
      ]
    },
    "encounter_treatments": {
      "columns": [
        "tenantId",
        "encounterId",
        "name",
        "status",
        "performedAt",
        "performedBy",
        "notes",
        "createdBy",
        "createdAt",
        "updatedAt"
      ],
      "indexes": [
        "tenant_encounter"
      ]
    },
    "clinical_drafts": {
      "columns": [
        "tenantId",
        "patientId",
        "encounterId",
        "sourceDocumentId",
        "draftContent",
        "status",
        "createdBy",
        "reviewedBy",
        "reviewedAt",
        "version",
        "createdAt",
        "updatedAt"
      ],
      "indexes": [
        "tenant_encounter_status"
      ]
    },
    "activity_events": {
      "columns": [
        "tenantId",
        "actorUserId",
        "actorService",
        "action",
        "entityType",
        "entityId",
        "occurredAt",
        "outcome",
        "correlationId",
        "summary"
      ],
      "indexes": [
        "tenant_occurred"
      ]
    }
  },
  "storage": {
    "bucketId": "dental-source-documents",
    "fileSecurity": true,
    "maximumFileSize": 26214400,
    "allowedFileExtensions": [
      "pdf",
      "jpg",
      "jpeg",
      "png",
      "webp"
    ],
    "encryption": true
  },
  "notes": [
    "Canonical prototype schema v0.2 for Appwrite project 6adcea89003c9613425b and database clearflow_dental.",
    "Schema changes must be applied through the GitHub Actions migration workflow; do not hand-edit table permissions in the Appwrite console.",
    "All tables must retain rowSecurity=true and empty table-level permissions; access is granted only by trusted API operations and explicit row permissions.",
    "clinic_memberships requires a userId+status index because clinic.list and membership checks filter by those fields.",
    "This manifest is the current prototype schema, not an enterprise or regulatory-readiness declaration."
  ]
}
